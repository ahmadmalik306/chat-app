{
  "compilerOptions": {
    // Core
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2021",
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",

    "resolveJsonModule": true,
    "esModuleInterop": true,
    // Optional Flags
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true
  }
}
